# Public front door for the Fleetbase API.
# /etc/caddy/onboarding.conf is written by the entrypoint: it holds a handler that rejects public
# self-signup, or is empty when PUBLIC_ONBOARDING=true.
{
	admin off
	auto_https off
	persist_config off
}

:{$PORT} {
	log {
		output stdout
		format console
		level ERROR
	}

	# Railway healthcheck: answered by the front door so the deploy goes healthy while the
	# first-boot migrations are still running.
	handle /healthz {
		respond "ok" 200
	}

	import /etc/caddy/onboarding.conf

	handle {
		reverse_proxy 127.0.0.1:{$INTERNAL_PORT} {
			header_up X-Forwarded-Proto {$FORWARD_PROTO:https}
			transport http {
				read_timeout 300s
				write_timeout 300s
			}
		}
	}
}
